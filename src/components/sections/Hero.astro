---
import type { z } from "astro/zod";
import type { heroSchema } from "@/content/schemas";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";

type Props = z.infer<typeof heroSchema> & { headingLevel?: 1 | 2 };
const { id, heading, subheading, primaryCta, secondaryCta, headingLevel = 1 } = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<section id={id} aria-labelledby={`${id}-titulo`} class="bg-surface py-16 sm:py-24">
  <Container class="max-w-3xl">
    <Heading id={`${id}-titulo`} class="text-4xl font-bold sm:text-5xl">
      {heading}
    </Heading>
    <p class="mt-6 max-w-prose text-lg text-muted">{subheading}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href={primaryCta.href}>{primaryCta.label}</Button>
      {secondaryCta && (
        <Button href={secondaryCta.href} variant="secondary">
          {secondaryCta.label}
        </Button>
      )}
    </div>
  </Container>
</section>
