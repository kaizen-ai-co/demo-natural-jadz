    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "links": "node scripts/check-links.mjs",
    "shots": "node scripts/shots.mjs",
    "contrast": "node scripts/contrast.mjs",
    "og": "node scripts/og-image.mjs",
