---
import { getEntry } from "astro:content";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import { StatusBadge } from "@/components/ui/StatusBadge";
import AgenciaDemo from "@/demo/AgenciaDemo";

const entry = await getEntry("agencia", "natural-jadz");
if (!entry) throw new Error("Falta src/content/agencia/natural-jadz.json");
const demo = entry.data;
---

<BaseLayout title={demo.title} description={demo.description} noindex>
  <Container class="py-6 sm:py-10">
    <p
      role="note"
      class="mb-5 rounded-md border border-status-prototype bg-bg p-3 text-sm font-semibold text-status-prototype"
    >
      {demo.fictionalNotice}
    </p>
    <h1 class="text-3xl font-extrabold sm:text-5xl">{demo.heading}</h1>
    <p class="mt-3 max-w-prose text-lg text-muted">{demo.intro}</p>

    <div class="mt-6">
      <AgenciaDemo client:load content={demo} />
    </div>

    <section aria-labelledby="funciones-titulo" class="mt-14 border-t border-border pt-8">
      <h2 id="funciones-titulo" class="text-xl font-extrabold">
        {demo.funcionesTitulo}
      </h2>
      <ul class="mt-4 grid gap-3 md:grid-cols-3">
        {demo.funciones.map((f) => (
          <li class="rounded-md border border-border bg-bg p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-bold">{f.name}</span>
              <StatusBadge status={f.status} label={demo.statusLabels[f.status]} />
            </div>
            <p class="mt-1 text-sm text-muted">{f.description}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm font-semibold">{demo.pie}</p>
    </section>
  </Container>
</BaseLayout>
