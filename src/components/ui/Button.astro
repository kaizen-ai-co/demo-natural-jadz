---
import { cn } from "@/lib/utils";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  type?: "button" | "submit";
  class?: string;
}

const { href, variant = "primary", type = "button", class: className } = Astro.props;

const classes = cn(
  "inline-flex min-h-tap items-center justify-center gap-2 rounded-md px-5 py-2 font-semibold no-underline transition-colors",
  variant === "primary" && "bg-primary text-primary-fg hover:bg-primary/90",
  variant === "secondary" && "border border-primary bg-bg text-primary hover:bg-surface",
  variant === "ghost" && "text-primary underline-offset-4 hover:underline",
  className,
);
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
