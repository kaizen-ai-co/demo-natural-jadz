---
import { site } from "@/content/site";
import Container from "@/components/ui/Container.astro";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => !href.includes("#") && href.replace(/\/$/, "") === current;
const hasNav = site.nav.length > 0;
---

<header class="border-b border-border bg-bg">
  <Container class="flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="min-h-tap inline-flex items-center text-lg font-bold text-fg no-underline">
      {site.logo ? (
        <img
          src={site.logo.src}
          alt={site.logo.alt}
          width={site.logo.width}
          height={site.logo.height}
          class="h-10 w-auto"
        />
      ) : (
        site.name
      )}
    </a>

    {hasNav && (
      <nav aria-label={site.menuLabel} class="hidden md:block">
        <ul class="flex gap-6">
          {site.nav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                class="min-h-tap inline-flex items-center text-fg underline-offset-4 hover:underline aria-[current=page]:font-semibold aria-[current=page]:underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {hasNav && (
      <details class="relative md:hidden">
        <summary class="min-h-tap inline-flex cursor-pointer list-none items-center rounded-md border border-border px-4 font-semibold">
          {site.menuLabel}
        </summary>
        <nav
          aria-label={site.menuLabel}
          class="absolute right-0 z-20 mt-2 w-56 rounded-md border border-border bg-bg p-2 shadow-lg"
        >
          <ul>
            {site.nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                  class="min-h-tap flex items-center rounded-sm px-3 text-fg no-underline hover:bg-surface aria-[current=page]:font-semibold"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )}

    <slot name="header-extra" />
  </Container>
</header>
